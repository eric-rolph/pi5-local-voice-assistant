"""
Configuration secrets template for GLADOS Voice Assistant

IMPORTANT:
1. Copy this file to 'secrets.py' in the same directory
2. Fill in your actual values in the secrets.py file
3. NEVER commit secrets.py to version control (it's in .gitignore)
4. Keep your credentials secure
"""

secrets = {
    # Optional: WiFi Configuration (if your Pi needs network access)
    # Leave empty strings if not needed - all processing is local
    "ssid": "",
    "password": "",

    # Optional: External API Keys (if you want cloud integrations)
    # The default setup works 100% locally without any API keys
    "openai_api_key": "",  # Only if you want OpenAI integration
    "anthropic_api_key": "",  # Only if you want Claude integration
    
    # Optional: Timezone Configuration
    # Examples: "America/New_York", "Europe/London", "Asia/Tokyo", "America/Denver"
    "timezone": "UTC",
    
    # Optional: UTC offset (hours as integer, e.g., -5 for EST, 1 for CET)
    "utc_offset": 0,
}

# Validation function
def validate_secrets():
    """Check if required secrets are configured"""
    errors = []
    warnings = []
    
    # Check WiFi (optional)
    if secrets.get("ssid") and not secrets.get("password"):
        errors.append("WiFi SSID configured but password is missing")
    
    # Validate API keys if provided
    api_key = secrets.get("openai_api_key", "")
    if api_key and not api_key.startswith("sk-"):
        warnings.append("OpenAI API key doesn't look valid (should start with 'sk-')")
    
    return errors, warnings

# Optional: Test configuration
if __name__ == "__main__":
    errors, warnings = validate_secrets()
    
    if errors:
        print("❌ Configuration errors found:")
        for error in errors:
            print(f"   - {error}")
    
    if warnings:
        print("⚠️  Configuration warnings:")
        for warning in warnings:
            print(f"   - {warning}")
    
    if not errors and not warnings:
        print("✅ Configuration template is ready!")
        print("\nNote: This is the template file.")
        print("Copy to 'secrets.py' and add your actual credentials.")
